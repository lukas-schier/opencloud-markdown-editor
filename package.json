{
  "name": "web-app-markdown-editor",
  "version": "0.1.0",
  "description": "A WYSIWYG Markdown editor for OpenCloud",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm vite build",
    "build:w": "pnpm vite build --watch --mode development",
    "build:s": "pnpm build && docker compose restart opencloud",
    "env:create": "docker compose create",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,ts,vue}' --color",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=throw vitest"
  },
  "devDependencies": {
    "@opencloud-eu/eslint-config": "^8.0.0",
    "@opencloud-eu/prettier-config": "^8.0.0",
    "@opencloud-eu/tsconfig": "^8.0.0",
    "@opencloud-eu/web-client": "^8.0.0",
    "@opencloud-eu/web-pkg": "^8.0.0",
    "eslint": "^9.39.5",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.11",
    "vue3-gettext": "^2.4.0"
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@opencloud-eu/extension-sdk": "^8.0.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "floating-vue": "^5.4.0",
    "tiptap-markdown": "^0.9.0",
    "unplugin-icons": "^23.0.1"
  },
  "packageManager": "pnpm@10.28.0"
}
